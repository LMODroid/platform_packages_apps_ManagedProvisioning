# proto-file: build/make/tools/aconfig/aconfig_protos/aconfig.proto
# proto-message: flag_declarations

package: "com.android.managedprovisioning.flags"
container: "system"

flag {
  name: "is_cosmic_ray_enabled"
  namespace: "enterprise"
  description: "Enables Cosmic Ray features"
  bug: "288413994"
}

flag {
  name: "bad_state_v3_early_rh_download_enabled"
  namespace: "enterprise"
  description: "Download and provision role holder provisioning before precondition checks"
  bug: "347912855"
}

flag {
  name: "underline_policy_link"
  namespace: "enterprise"
  description: "Underline the policy link in the View Terms page"
  bug: "365473481"
}

flag {
  name: "check_frp_active"
  namespace: "enterprise"
  description: "Fix persistent data block check for provisioning"
  bug: "365473481"
}

flag {
  name: "terms_view_accessibility_enabled"
  namespace: "enterprise"
  description: "Enable Expand/Collapse accesbility announcement for terms view"
  bug: "386329540"
}

flag {
  name: "stop_disruptive_announcement_education"
  namespace: "enterprise"
  description: "Stop TalkBack disruptive announcement for the header of the work profile education screens"
  bug: "386334889"
}
